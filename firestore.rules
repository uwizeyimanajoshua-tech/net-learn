rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'uwizeyimanajoshua@gmail.com' ||
        request.auth.token.email == 'joshua@nexalearn.ai' ||
        (request.auth.token.email_verified == true && request.auth.token.email.matches('.*admin.*')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Health check ping
    match /test/{testId} {
      allow read, write: if true;
    }

    // Documents: All students and guests can read learning course notes; ONLY administrators can create, update, or delete
    match /documents/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || request.auth == null;
    }

    // Users: Profiles and account settings
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Chats: Student conversation sessions with NIT AI
    match /chats/{chatId} {
      allow read: if true;
      allow write: if true;
    }

    // Quizzes: Multiple-choice course quizzes
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth == null;
    }

    // Flashcards: Educational cards
    match /flashcards/{flashcardId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
