{
  "entities": {
    "Document": {
      "title": "Document",
      "description": "Educational notes or textbook uploaded by admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the document"
        },
        "name": {
          "type": "string",
          "description": "Original file name of the document"
        },
        "type": {
          "type": "string",
          "description": "File format type (e.g. pdf, txt, docx)"
        },
        "size": {
          "type": "number",
          "description": "File size in bytes"
        },
        "category": {
          "type": "string",
          "description": "Educational category (e.g. Networking, Linux, Cloud)"
        },
        "textContent": {
          "type": "string",
          "description": "Extracted text content of the document"
        },
        "uploadedAt": {
          "type": "string",
          "description": "ISO timestamp of when the document was uploaded"
        },
        "userId": {
          "type": "string",
          "description": "ID of the user who uploaded the document"
        },
        "bookmarks": {
          "type": "array",
          "description": "Array of user IDs who bookmarked this document"
        },
        "splitContent": {
          "type": "array",
          "description": "Document sections split logically for search and RAG"
        },
        "summary": {
          "type": "object",
          "description": "Structured AI-generated summary"
        },
        "hasDrawings": {
          "type": "boolean",
          "description": "Whether document has architectural diagrams"
        },
        "fileUrl": {
          "type": "string",
          "description": "Stream URL for document"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "textContent",
        "uploadedAt",
        "userId"
      ]
    },
    "User": {
      "title": "User",
      "description": "User profile and account settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "Email address" },
        "username": { "type": "string", "description": "Display username" },
        "name": { "type": "string", "description": "Full name" },
        "role": { "type": "string", "description": "Role (student or admin)" },
        "isVerified": { "type": "boolean", "description": "Verification status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "email", "role"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "AI study chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique chat ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string", "description": "Conversation title" },
        "messages": { "type": "array", "description": "Array of chat messages" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "userId", "title"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Interactive multiple choice quiz",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique quiz ID" },
        "title": { "type": "string", "description": "Quiz title" },
        "category": { "type": "string", "description": "Course category" },
        "docId": { "type": "string", "description": "Associated document ID" },
        "questions": { "type": "array", "description": "Questions array" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "title", "category", "questions"]
    },
    "OfficialExam": {
      "title": "OfficialExam",
      "description": "Administrator-created official timed and locked examination visible to all website users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique exam ID" },
        "title": { "type": "string", "description": "Exam title" },
        "description": { "type": "string", "description": "Instructions or exam summary" },
        "category": { "type": "string", "description": "Course category" },
        "docId": { "type": "string", "description": "Optional linked course document ID" },
        "createdBy": { "type": "string", "description": "Admin user ID" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" },
        "durationMinutes": { "type": "number", "description": "Countdown timer duration in minutes" },
        "availableUntil": { "type": "string", "description": "Optional closing deadline ISO timestamp" },
        "isPublished": { "type": "boolean", "description": "Whether exam is visible to all accounts" },
        "isLocked": { "type": "boolean", "description": "Admin master lock flag" },
        "accessCode": { "type": "string", "description": "Optional PIN code to start exam" },
        "allowRetake": { "type": "boolean", "description": "Whether students can retake after submitting" },
        "hideAfterSubmitOrExpiry": { "type": "boolean", "description": "Hide active exam after submission or timeout" },
        "preventTabSwitch": { "type": "boolean", "description": "Block tab switching during exam" },
        "maxTabSwitches": { "type": "number", "description": "Allowed switches before auto-submit" },
        "preventCopyPaste": { "type": "boolean", "description": "Disable copy/cut/paste/selection during exam" },
        "requireFullscreen": { "type": "boolean", "description": "Require fullscreen mode during exam" },
        "passingScorePercent": { "type": "number", "description": "Minimum passing percentage" },
        "showResultsAfterSubmit": { "type": "boolean", "description": "Reveal score breakdown after submission" },
        "questions": { "type": "array", "description": "Exam questions array" }
      },
      "required": ["id", "title", "category", "durationMinutes", "questions"]
    },
    "ExamSession": {
      "title": "ExamSession",
      "description": "Active countdown and violation tracking session for an examinee",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Composite examId__userId" },
        "examId": { "type": "string", "description": "Exam ID" },
        "userId": { "type": "string", "description": "Student user ID" },
        "startedAt": { "type": "string", "description": "Server start ISO timestamp" },
        "expiresAt": { "type": "string", "description": "Server expiry ISO timestamp" },
        "tabSwitchCount": { "type": "number", "description": "Recorded tab switch violations" },
        "status": { "type": "string", "description": "active, submitted, or expired" }
      },
      "required": ["id", "examId", "userId", "startedAt", "expiresAt", "status"]
    },
    "ExamSubmission": {
      "title": "ExamSubmission",
      "description": "Graded official exam submission record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Submission ID" },
        "examId": { "type": "string", "description": "Exam ID" },
        "examTitle": { "type": "string", "description": "Exam title" },
        "category": { "type": "string", "description": "Course category" },
        "userId": { "type": "string", "description": "Student user ID" },
        "username": { "type": "string", "description": "Student display name" },
        "userEmail": { "type": "string", "description": "Student email" },
        "score": { "type": "number", "description": "Points earned" },
        "maxScore": { "type": "number", "description": "Total questions" },
        "percentage": { "type": "number", "description": "Percentage score" },
        "passed": { "type": "boolean", "description": "Whether student passed" },
        "submittedAt": { "type": "string", "description": "Submission ISO timestamp" },
        "autoSubmitted": { "type": "boolean", "description": "Whether submitted automatically" },
        "autoSubmitReason": { "type": "string", "description": "Reason for auto submission" },
        "tabSwitchCount": { "type": "number", "description": "Detected tab switches" },
        "timeTakenSeconds": { "type": "number", "description": "Time taken in seconds" }
      },
      "required": ["id", "examId", "userId", "score", "maxScore", "submittedAt"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "Study flashcard",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique flashcard ID" },
        "userId": { "type": "string", "description": "User ID" },
        "category": { "type": "string", "description": "Category" },
        "front": { "type": "string", "description": "Front prompt" },
        "back": { "type": "string", "description": "Back explanation" },
        "isMastered": { "type": "boolean", "description": "Mastered status" }
      },
      "required": ["id", "userId", "front", "back"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Health check document",
      "type": "object",
      "properties": {
        "ping": { "type": "boolean", "description": "Ping indicator" },
        "time": { "type": "string", "description": "Timestamp" }
      },
      "required": ["ping"]
    }
  },
  "firestore": {
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "Collection of learning documents and textbooks uploaded by admins"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and accounts"
    },
    "/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "Student AI study chat sessions"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Course quizzes and self-assessments"
    },
    "/exams/{examId}": {
      "schema": "OfficialExam",
      "description": "Official admin-created timed and locked exams"
    },
    "/exam_sessions/{sessionId}": {
      "schema": "ExamSession",
      "description": "Active countdown and proctoring sessions"
    },
    "/exam_submissions/{submissionId}": {
      "schema": "ExamSubmission",
      "description": "Graded student exam submissions"
    },
    "/flashcards/{flashcardId}": {
      "schema": "Flashcard",
      "description": "Study flashcards"
    },
    "/test/{testId}": {
      "schema": "TestConnection",
      "description": "Firestore health check document"
    }
  }
}
