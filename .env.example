# GEMINI_API_KEY: Required for NIT AI tutoring, live chat, syllabus explanations, and quizzes.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon Lakebase Postgres (configured automatically by neon deploy)
DATABASE_URL="postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# AWS / Neon Object Storage (S3-compatible) for unlimited document & textbook uploads up to 100MB
AWS_ACCESS_KEY_ID="MY_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="MY_AWS_SECRET_ACCESS_KEY"
AWS_ENDPOINT_URL_S3="https://s3.us-east-2.amazonaws.com"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="assets"
